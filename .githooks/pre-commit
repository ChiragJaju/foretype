#!/bin/sh
# Blocks big files and secrets, then formats and lints only the staged files; each tool runs only when a file
# of its kind is staged, so a commit stays under about 2 s. Formatting re-adds whole files, so stage a file fully.
set -eu

MAX_FILE_BYTES=1048576
LOCKFILES='^(site/)?package-lock\.json$'

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -n "$staged" ] || exit 0

# The staged files matching an extended regex, one per line.
staged_matching() { printf '%s\n' "$staged" | grep -E "$1" || true; }
# Runs `tool args... files...` with the files on stdin, or says once that the tool is missing.
run_on() {
  files="$1"
  shift
  [ -n "$files" ] || return 0
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "pre-commit: $1 not installed, skipped (make doctor)"
    return 0
  fi
  printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 "$@"
}

printf '%s\n' "$staged" | while IFS= read -r path; do
  printf '%s\n' "$path" | grep -qE "$LOCKFILES" && continue
  size="$(git cat-file -s ":$path")"
  [ "$size" -le "$MAX_FILE_BYTES" ] && continue
  echo "pre-commit: $path is $size bytes, over the 1 MB limit"
  exit 1
done || exit 1

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --redact --no-banner --log-level warn .
else
  echo "pre-commit: gitleaks not installed, secret scan skipped (brew install gitleaks)"
fi

swift_files="$(staged_matching '^app/.*\.swift$')"
if [ -n "$swift_files" ]; then
  run_on "$swift_files" swift format --in-place
  run_on "$swift_files" git add --
  run_on "$swift_files" swiftlint lint --strict --quiet
fi

formatted_files="$(staged_matching '^(site/src|scripts)/.*\.(js|mjs|ts|tsx|css|json)$')"
if [ -n "$formatted_files" ]; then
  run_on "$formatted_files" npx --no-install oxfmt
  run_on "$formatted_files" git add --
fi

site_files="$(staged_matching '^site/src/.*\.(ts|tsx)$' | sed 's|^site/||')"
if [ -n "$site_files" ]; then
  (cd site && run_on "$site_files" npx --no-install oxlint --deny-warnings)
fi

run_on "$(staged_matching '\.sh$|^\.githooks/')" shellcheck
run_on "$staged" typos --force-exclude --

workflow_files="$(staged_matching '^\.github/workflows/[^/]+\.ya?ml$')"
run_on "$workflow_files" actionlint
run_on "$workflow_files" zizmor --offline

run_on "$(staged_matching '(^|/)(AGENTS|CLAUDE|SKILL)\.md$|^\.claude/')" npx --no-install agnix --strict
